{
  "deepseek_api_key": "",
  "deepseek_model": "deepseek-v4-flash",
  "deepseek_base_url": "https://api.deepseek.com/chat/completions",
  "ck3_user_dir": "<CK3用户目录>",
  "save_dir": "<CK3用户目录>/save games",
  "ck3_game_dir": "<CK3游戏根目录, 含 game/localization 与 game/common; 留空自动发现>",
  "rakaly_path": "<项目目录>/tools/rakaly.exe",
  "data_dir": "<项目目录>/data (仅全局表: names/localization/province; 熔化存档位于 output/<宗族>/data/)",
  "cache_dir": "<项目目录>/cache (仅迁移用, v4 起缓存位于 output/<家族>/data/)>",
  "output_dir": "<项目目录>/output",
  "log_dir": "<项目目录>/logs",
  "log_console_detail": false,
  "poll_interval_seconds": 3600,
  "compact_codec": "xz",
  "max_tokens": 12800,
  "temperature": 1.1,
  "prompt_log_enabled": true,
  "llm_thinking_disabled": true,
  "auto_bio_on_death": true,
  "carnal_opinions": false,
  "bio_sections": ["lead", "mid", "tail"]
}
